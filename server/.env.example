# ---------- server ----------
PORT=4000
NODE_ENV=development
# Time zone used for dates written to Google Sheets and CSV exports
TIMEZONE=Asia/Tbilisi

# ---------- database ----------
# mongo (default) or memory (demo mode, no database needed, data lost on restart)
DB_DRIVER=mongo
# Local MongoDB or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/matematika

# ---------- auth ----------
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Password for the teacher dashboard (/teacher)
TEACHER_KEY=change-me-teacher-key

# ---------- web ----------
# Only needed if the React app is served from another origin (comma-separated)
# CORS_ORIGIN=http://localhost:5173
# Behind a reverse proxy (Render, Railway, Nginx): set to 1
# TRUST_PROXY=1

# ---------- Google Sheets mirror ----------
# off | apps-script | service-account
SHEETS_MODE=off
# How often pending rows are pushed (seconds). Finished tests are also pushed right away.
SHEETS_SYNC_INTERVAL_SEC=60

# Option A — Apps Script web app (simplest; see google-apps-script/README.md)
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# SHEETS_WEBHOOK_SECRET=same-value-as-SECRET-in-Code.gs

# Option B — Google Cloud service account (see README.md → Google Sheets)
# GOOGLE_SHEET_ID=1AbC...the id in the spreadsheet URL...
# GOOGLE_SERVICE_ACCOUNT_EMAIL=matematika@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
